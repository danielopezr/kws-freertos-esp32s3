# Fixed configuration for every experiment (see docs and the plan). Change only on purpose.
CONFIG_IDF_TARGET="esp32s3"

# CPU and flash: ESP32-S3 N16R8
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM, only reachable through heap_caps_malloc(..., MALLOC_CAP_SPIRAM):
# plain malloc never lands in PSRAM, so memory placement stays an explicit experiment factor
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# FreeRTOS: 1 kHz tick and per-task run-time statistics (vTaskGetRunTimeStats)
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Optimise for speed (same binary for every run)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
